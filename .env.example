# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored and will never be committed — that's what keeps these secret.
# Never paste real key values into chat, commits, or anywhere outside this file.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: full admin access to the database. Server-side only, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Voyage AI embeddings API key (dash.voyageai.com)
VOYAGE_API_KEY=
