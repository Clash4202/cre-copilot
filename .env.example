# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored and will never be committed — that's what keeps these secret.
# Never paste real key values into chat, commits, or anywhere outside this file.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: full admin access to the database. Server-side only, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Voyage AI embeddings API key (dash.voyageai.com)
VOYAGE_API_KEY=

# Resend API key (resend.com) — used to email Clayton when someone requests a demo via the
# landing page. Reuses the same Resend account already configured as custom SMTP for
# Supabase magic-link emails; no new account needed.
RESEND_API_KEY=

# Email address that receives demo request notifications.
DEMO_REQUEST_NOTIFY_EMAIL=

# "From" address for demo request notification emails. Defaults to Resend's shared sandbox
# sender (onboarding@resend.dev) if unset, which only delivers to the account owner's own
# verified address. Set to a verified custom domain address (e.g. the same domain used for
# Supabase magic-link emails) in production.
RESEND_FROM_EMAIL=

# Base URL of this app (http://localhost:3000 for local dev)
NEXT_PUBLIC_SITE_URL=
